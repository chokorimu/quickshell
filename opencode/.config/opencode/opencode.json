{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figcraft": {
      "type": "local",
      "command": ["figcraft-cli", "mcp"]
    },
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  },
  "provider": {
    "tig": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "tig",
      "options": {
        "baseURL": "https://api.trustisgold.web.id/v1"
      },
      "models": {
        "tig/step-5-unrestricted": {
          "name": "step-5-unrestricted"
        },
        "tig/deepseek-unrestricted": {
          "name": "deepseek-unrestricted"
        },
        "tig/step-5-preview": {
          "name": "step-5-preview"
        },
        "tig/step-3.7-unrestricted": {
          "name": "step-3.7-unrestricted"
        },
        "tig/step-3.7-flash": {
          "name": "step-3.7-flash"
        },
        "tig/step-3.5-flash": {
          "name": "step-3.5-flash"
        },
        "tig/minimax-m2.7": {
          "name": "minimax-m2.7"
        }
      }
    },
    "nusagate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "nusagate",
      "options": {
        "baseURL": "https://api.nusagate.com/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash"
        }
      }
    },
    "gutsai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "gutsai",
      "options": {
        "baseURL": "https://api.gutsai.id/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash"
        }
      }
    },
    "weizerouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "weizerouter",
      "options": {
        "baseURL": "https://weizerouter.web.id/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash"
        },
        "wz/deepseek-v4-flash-0731": {
          "name": "deepseek-v4-flash-0731"
        },
        "wz/gpt-6-luna": {
          "name": "gpt-6-luna"
        },
        "cx/gpt-6-luna": {
          "name": "gpt-6-luna"
        }
      }
    },
    "weizerouter-uncensored": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "weizerouter",
      "options": {
        "baseURL": "https://weizerouter.web.id/v1"
      },
      "models": {
        "wz/uc-deepseek-v4.1-flash": {
          "name": "uc-deepseek-v4.1-flash"
        },
        "wz/uc-venice-roleplay": {
          "name": "uc-venice-roleplay"
        }
      }
    }
  }
}